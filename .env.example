NODE_ENV=development
PORT=4000
PUBLIC_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3000/admin
DATABASE_URL=postgresql://algi:algi_dev_password@localhost:5432/algi?schema=public
REDIS_URL=redis://localhost:6379
# Создайте через @BotFather. Никогда не коммитьте токен.
TELEGRAM_BOT_TOKEN=
TELEGRAM_LEADS_CHAT_ID=
# false = только номер/тип/источник лида, без телефона, email и сообщения.
TELEGRAM_INCLUDE_PERSONAL_DATA=false
LEAD_RETENTION_DAYS=365
IP_HASH_SECRET=replace-with-at-least-32-random-characters
TRUST_PROXY=false
ORDER_RESERVATION_MINUTES=30
# Реквизиты продавца. В production обязательные поля валидируются при запуске.
# Не подставляйте демонстрационные реквизиты: заполните данными реального оператора сайта.
COMPANY_DISPLAY_NAME=
COMPANY_LEGAL_NAME=
COMPANY_INN=
COMPANY_KPP=
COMPANY_OGRN=
COMPANY_LEGAL_ADDRESS=
COMPANY_POSTAL_ADDRESS=
COMPANY_WAREHOUSE_ADDRESS=
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_TELEGRAM_URL=
COMPANY_WHATSAPP_URL=

# Банковские реквизиты не публикуются через storefront API.
COMPANY_BANK_NAME=
COMPANY_BANK_BIK=
COMPANY_BANK_CORRESPONDENT_ACCOUNT=
COMPANY_BANK_SETTLEMENT_ACCOUNT=
COMPANY_TAX_SYSTEM=
COMPANY_VAT_LABEL=

# Канал для обращений субъектов персональных данных.
# Если пусто, используется COMPANY_EMAIL.
PRIVACY_CONTACT_EMAIL=

# Первый администратор создаётся при старте, только если пользователя с таким email ещё нет.
# Пароль production: минимум 16 символов. После первичного входа удалите пароль из окружения.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Администратор
ADMIN_SESSION_HOURS=12

# Платежи. В development допустим manual; для production используйте yookassa.
PAYMENT_PROVIDER=manual
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:3000/checkout/complete
# Код ставки НДС по договору с кассовым провайдером; подтвердите у бухгалтера.
YOOKASSA_VAT_CODE=

# 32 байта в hex (64 символа) для AES-256-GCM кодов маркировки.
MARKING_ENCRYPTION_KEY=

# Production-gates: ставьте true только после фактической проверки и документирования.
LEGAL_DOCUMENTS_APPROVED=false
RKN_NOTIFICATION_CONFIRMED=false
DATA_LOCALIZATION_CONFIRMED=false
MARKING_READINESS_CONFIRMED=false
ALLOW_MANUAL_PAYMENT_IN_PRODUCTION=false

DELIVERY_QUOTE_SECRET=replace-with-at-least-32-random-characters
COURIER_PRICE_KOPECKS=49000
CDEK_ENABLED=false
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_ORIGIN_CITY_CODE=
