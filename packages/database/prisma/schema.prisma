generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum RoastLevel {
  LIGHT
  MEDIUM
  DARK
}

enum Grind {
  WHOLE
  ESPRESSO
  FILTER
  FRENCH_PRESS
  TURKISH
}

enum LeadAudience {
  HOME
  CAFE
  RESTAURANT
  WHOLESALE
  PRIVATE_LABEL
  OTHER
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  QUALIFIED
  WON
  LOST
  DELETED
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

enum UserRole {
  ADMIN
  MANAGER
  CONTENT_MANAGER
  WAREHOUSE
}

enum ConsentPurpose {
  LEAD_RESPONSE
  ORDER_FULFILLMENT
  MARKETING
  ANALYTICS
}

enum OrderStatus {
  NEW
  AWAITING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PrivacyRequestType {
  ACCESS
  CORRECTION
  DELETION
  RESTRICTION
  CONSENT_WITHDRAWAL
}

enum PrivacyRequestStatus {
  NEW
  IDENTITY_CHECK
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Brand {
  id          String      @id @default(uuid()) @db.Uuid
  slug        String      @unique
  name        String
  tagline     String?
  description String?
  roastLevel  RoastLevel? @map("roast_level")
  audience    String?
  origins     String[]
  imageUrl    String?     @map("image_url")
  sortOrder   Int         @default(0) @map("sort_order")
  isActive    Boolean     @default(true) @map("is_active")
  products    Product[]
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  @@map("brands")
}

model Country {
  id                  String           @id @default(uuid()) @db.Uuid
  slug                String           @unique
  name                String
  region              String?
  lead                String?
  tasteNotes          String[]         @map("taste_notes")
  aroma               String[]
  altitude            String?
  processing          String?
  acidity             Int?
  body                Int?
  roastRecommendation String?          @map("roast_recommendation")
  imageUrl            String?          @map("image_url")
  products            ProductCountry[]
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  @@map("countries")
}

model Product {
  id                  String           @id @default(uuid()) @db.Uuid
  slug                String           @unique
  name                String
  brandId             String           @map("brand_id") @db.Uuid
  brand               Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  description         String?
  flavorDescriptors   String[]         @map("flavor_descriptors")
  roastLevel          RoastLevel       @map("roast_level")
  isDecaf             Boolean          @default(false) @map("is_decaf")
  process             String?
  altitude            String?
  cuppingScore        Decimal?         @map("cupping_score") @db.Decimal(4, 1)
  images              String[]
  status              ProductStatus    @default(DRAFT)
  seoTitle            String?          @map("seo_title")
  seoDescription      String?          @map("seo_description")
  ingredients         String?
  manufacturerName    String?          @map("manufacturer_name")
  manufacturerAddress String?          @map("manufacturer_address")
  productionCountry   String?          @map("production_country")
  shelfLifeDays       Int?             @map("shelf_life_days")
  storageConditions   String?          @map("storage_conditions")
  preparation         String?
  conformityDocument  String?          @map("conformity_document")
  sortOrder           Int              @default(0) @map("sort_order")
  countries           ProductCountry[]
  variants            ProductVariant[]
  roastBatches        RoastBatch[]
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  deletedAt           DateTime?        @map("deleted_at")

  @@index([status, sortOrder])
  @@index([brandId, status])
  @@map("products")
}

model ProductCountry {
  productId String  @map("product_id") @db.Uuid
  countryId String  @map("country_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  country   Country @relation(fields: [countryId], references: [id], onDelete: Restrict)

  @@id([productId, countryId])
  @@index([countryId])
  @@map("product_countries")
}

model ProductVariant {
  id              String        @id @default(uuid()) @db.Uuid
  productId       String        @map("product_id") @db.Uuid
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  weightG         Int           @map("weight_g")
  grind           Grind
  sku             String        @unique
  priceKopecks    Int           @map("price_kopecks")
  compareAtPrice  Int?          @map("compare_at_price_kopecks")
  stockQty        Int           @default(0) @map("stock_qty")
  reservedQty     Int           @default(0) @map("reserved_qty")
  isActive        Boolean       @default(true) @map("is_active")
  barcode         String?
  gtin            String?       @unique
  tnVedCode       String?       @map("tn_ved_code")
  okpd2Code       String?       @map("okpd2_code")
  markingRequired Boolean       @default(false) @map("marking_required")
  markingUnits    MarkingUnit[]
  orderItems      OrderItem[]
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@unique([productId, weightG, grind])
  @@index([isActive, stockQty])
  @@map("product_variants")
}

model Order {
  id              String        @id @default(uuid()) @db.Uuid
  publicId        String        @unique @map("public_id")
  idempotencyKey  String        @unique @map("idempotency_key")
  status          OrderStatus   @default(NEW)
  customerName    String        @map("customer_name")
  customerPhone   String        @map("customer_phone")
  customerEmail   String?       @map("customer_email")
  deliveryMethod  String        @map("delivery_method")
  deliveryAddress Json?         @map("delivery_address")
  customerComment String?       @map("customer_comment")
  subtotalKopecks Int           @map("subtotal_kopecks")
  deliveryKopecks Int           @default(0) @map("delivery_kopecks")
  discountKopecks Int           @default(0) @map("discount_kopecks")
  promoCode       String?       @map("promo_code")
  totalKopecks    Int           @map("total_kopecks")
  expiresAt       DateTime?     @map("expires_at")
  paidAt          DateTime?     @map("paid_at")
  items           OrderItem[]
  payments        Payment[]
  events          OrderEvent[]
  shipment        Shipment?
  refunds         Refund[]
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([customerPhone, createdAt])
  @@map("orders")
}

model OrderItem {
  id                String         @id @default(uuid()) @db.Uuid
  orderId           String         @map("order_id") @db.Uuid
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variantId         String         @map("variant_id") @db.Uuid
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  sku               String
  productName       String         @map("product_name")
  variantDescription String        @map("variant_description")
  quantity          Int
  unitPriceKopecks  Int            @map("unit_price_kopecks")
  totalKopecks      Int            @map("total_kopecks")
  createdAt         DateTime       @default(now()) @map("created_at")

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider          String
  externalId        String?       @unique @map("external_id")
  idempotencyKey    String        @unique @map("idempotency_key")
  status            PaymentStatus @default(PENDING)
  amountKopecks     Int           @map("amount_kopecks")
  confirmationUrl   String?       @map("confirmation_url")
  fiscalReceiptRef  String?       @map("fiscal_receipt_ref")
  rawResponse       Json?         @map("raw_response")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  refunds           Refund[]

  @@index([orderId, status])
  @@map("payments")
}

model Promotion {
  id               String       @id @default(uuid()) @db.Uuid
  code             String       @unique
  discountType     DiscountType @map("discount_type")
  discountValue    Int          @map("discount_value")
  minSubtotalKopecks Int        @default(0) @map("min_subtotal_kopecks")
  startsAt         DateTime?     @map("starts_at")
  endsAt           DateTime?     @map("ends_at")
  maxUses          Int?         @map("max_uses")
  usedCount        Int          @default(0) @map("used_count")
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  @@index([isActive, startsAt, endsAt])
  @@map("promotions")
}

model Shipment {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @unique @map("order_id") @db.Uuid
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider       String
  status         String
  externalId     String?  @unique @map("external_id")
  trackingNumber String?  @map("tracking_number")
  trackingUrl    String?  @map("tracking_url")
  rawResponse    Json?    @map("raw_response")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  @@index([status, createdAt])
  @@map("shipments")
}

model Refund {
  id             String       @id @default(uuid()) @db.Uuid
  orderId        String       @map("order_id") @db.Uuid
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId      String       @map("payment_id") @db.Uuid
  payment        Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  externalId     String?      @unique @map("external_id")
  idempotencyKey String       @unique @map("idempotency_key")
  amountKopecks  Int          @map("amount_kopecks")
  status         RefundStatus @default(PENDING)
  reason         String?
  rawResponse    Json?        @map("raw_response")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  @@index([orderId, status])
  @@map("refunds")
}

model OrderEvent {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_events")
}

model MarkingUnit {
  id            String         @id @default(uuid()) @db.Uuid
  variantId     String         @map("variant_id") @db.Uuid
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  codeHash      String         @unique @map("code_hash")
  encryptedCode Bytes          @map("encrypted_code")
  status        String
  batchRef      String?        @map("batch_ref")
  introducedAt  DateTime?      @map("introduced_at")
  withdrawnAt   DateTime?      @map("withdrawn_at")
  withdrawalRef String?        @map("withdrawal_ref")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([variantId, status])
  @@map("marking_units")
}

model RoastBatch {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  roastedAt    DateTime @map("roasted_at")
  weightKg     Decimal  @map("weight_kg") @db.Decimal(8, 3)
  profile      String?
  cuppingNotes String?  @map("cupping_notes")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([productId, roastedAt])
  @@map("roast_batches")
}

model Lead {
  id             String             @id @default(uuid()) @db.Uuid
  publicId       String             @unique @map("public_id")
  audience       LeadAudience
  name           String
  phone          String?
  email          String?
  message        String?
  sourcePage     String             @map("source_page")
  utm            Json?
  status         LeadStatus         @default(NEW)
  assignedToId   String?            @map("assigned_to_id") @db.Uuid
  assignedTo     User?              @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  nextActionAt   DateTime?          @map("next_action_at")
  retentionUntil DateTime           @map("retention_until")
  notes          LeadNote[]
  notifications  LeadNotification[]
  consents       ConsentReceipt[]
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  deletedAt      DateTime?          @map("deleted_at")

  @@index([status, createdAt])
  @@index([retentionUntil])
  @@index([assignedToId, nextActionAt])
  @@map("leads")
}

model LeadNote {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @map("lead_id") @db.Uuid
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String   @map("author_id") @db.Uuid
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([leadId, createdAt])
  @@map("lead_notes")
}

model LeadNotification {
  id           String             @id @default(uuid()) @db.Uuid
  leadId       String             @map("lead_id") @db.Uuid
  lead         Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel      String
  status       NotificationStatus @default(PENDING)
  attemptCount Int                @default(0) @map("attempt_count")
  lastError    String?            @map("last_error")
  nextAttemptAt DateTime          @default(now()) @map("next_attempt_at")
  lockedAt     DateTime?          @map("locked_at")
  lockId       String?            @map("lock_id")
  sentAt       DateTime?          @map("sent_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@map("lead_notifications")
}

model ConsentDocument {
  id          String           @id @default(uuid()) @db.Uuid
  purpose     ConsentPurpose
  version     String
  title       String
  text        String
  publishedAt DateTime         @map("published_at")
  isActive    Boolean          @default(false) @map("is_active")
  receipts    ConsentReceipt[]
  createdAt   DateTime         @default(now()) @map("created_at")

  @@unique([purpose, version])
  @@index([purpose, isActive])
  @@map("consent_documents")
}

model ConsentReceipt {
  id             String          @id @default(uuid()) @db.Uuid
  documentId     String          @map("document_id") @db.Uuid
  document       ConsentDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  leadId         String?         @map("lead_id") @db.Uuid
  lead           Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  subjectRef     String          @map("subject_ref")
  acceptedAt     DateTime        @default(now()) @map("accepted_at")
  revokedAt      DateTime?       @map("revoked_at")
  ipHash         String?         @map("ip_hash")
  userAgent      String?         @map("user_agent")
  sourcePage     String          @map("source_page")
  collectionForm String          @map("collection_form")
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([subjectRef, acceptedAt])
  @@index([leadId])
  @@map("consent_receipts")
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique
  passwordHash  String     @map("password_hash")
  displayName   String     @map("display_name")
  role          UserRole
  isActive      Boolean    @default(true) @map("is_active")
  sessions      Session[]
  assignedLeads Lead[]     @relation("AssignedLeads")
  leadNotes     LeadNote[]
  auditLogs     AuditLog[]
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("sessions")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  changes    Json?
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model PrivacyRequest {
  id             String               @id @default(uuid()) @db.Uuid
  publicId       String               @unique @map("public_id")
  type           PrivacyRequestType
  status         PrivacyRequestStatus @default(NEW)
  name           String
  email          String?
  phone          String?
  details        String?
  subjectRef     String               @map("subject_ref")
  retentionUntil DateTime             @map("retention_until")
  resolvedAt     DateTime?            @map("resolved_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([subjectRef, createdAt])
  @@index([retentionUntil])
  @@map("privacy_requests")
}
